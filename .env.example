# Docmost + Traefik + Let's Encrypt — Environment Variables
# Copy this file to `.env` and fill in each value before `docker compose up`.
# `.env` is gitignored — never commit real credential values.
#
# Image versions are NOT set here. The tested tag + sha256 digest for every
# image lives in the compose file's `x-images` block, so `git pull` delivers
# the version combination this repository has tested. To pin a different
# version yourself, uncomment and set:
# DOCMOST_IMAGE_TAG=docmost/docmost:0.95.0@sha256:…

# ──────────────────────────────────────────────────────────────────────────────
# Traefik reverse proxy
# ──────────────────────────────────────────────────────────────────────────────

# Email address for Let's Encrypt renewal notices. REQUIRED.
TRAEFIK_ACME_EMAIL=admin@example.com

# Hostname for the Traefik dashboard (basic-auth protected). REQUIRED.
TRAEFIK_HOSTNAME=traefik.docmost.example.com

# Basic Authentication for the Traefik dashboard.
# Format: USERNAME:BCRYPT_HASH (with $ characters doubled to $$ for compose)
#     htpasswd -nbB traefikadmin YOUR_STRONG_PASSWORD | sed 's/\$/\$\$/g'
# REQUIRED — do not ship production without changing this.
TRAEFIK_BASIC_AUTH=change_me_generate_with_htpasswd_and_replace_this_string

# Log level: DEBUG, INFO, WARN, ERROR. Default: WARN.
# TRAEFIK_LOG_LEVEL=WARN

# ──────────────────────────────────────────────────────────────────────────────
# Docmost
# ──────────────────────────────────────────────────────────────────────────────

# Public hostname and full URL. The hostname must resolve to this server's
# public IP for the Let's Encrypt TLS-ALPN challenge. REQUIRED.
DOCMOST_HOSTNAME=docmost.example.com
DOCMOST_URL=https://docmost.example.com

# REQUIRED — generate with:
#     openssl rand -base64 24 | tr -d '/+=' | head -c 32
DOCMOST_DB_PASSWORD=change_me_before_first_start

# App secret for sessions/tokens. REQUIRED — generate with:
#     openssl rand -base64 48 | tr -d '/+=' | head -c 64
DOCMOST_SECRET=change_me_before_first_start

# The first account registered on the setup page becomes the workspace
# owner — open the site right after deploy.

# Defaults below are set in the compose file; override only to diverge.
# DOCMOST_DB_NAME=docmostdb
# DOCMOST_DB_USER=docmostdbuser

# ──────────────────────────────────────────────────────────────────────────────
# SMTP (optional — mail sending is inert until you set these)
# ──────────────────────────────────────────────────────────────────────────────

# DOCMOST_MAIL_DRIVER=smtp
# DOCMOST_SMTP_ADDRESS=smtp.example.com
# DOCMOST_SMTP_PORT=587
# DOCMOST_SMTP_SECURE=false
# DOCMOST_SMTP_USER_NAME=docmost@example.com
# DOCMOST_SMTP_PASSWORD=change_me
# DOCMOST_SMTP_NAME_FROM=Docmost
# DOCMOST_EMAIL_FROM=docmost@example.com

# ──────────────────────────────────────────────────────────────────────────────
# Backups (defaults shown; override only to tune)
# ──────────────────────────────────────────────────────────────────────────────

# BACKUP_INIT_SLEEP=30m
# BACKUP_INTERVAL=24h
# POSTGRES_BACKUP_PRUNE_DAYS=7
# DATA_BACKUP_PRUNE_DAYS=7
# POSTGRES_BACKUPS_PATH=/srv/docmost-postgres/backups
# DATA_BACKUPS_PATH=/srv/docmost-application-data/backups
# DATA_PATH=/app/data/storage
# POSTGRES_BACKUP_NAME=docmost-postgres-backup
# DATA_BACKUP_NAME=docmost-application-data-backup

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# DOCMOST_POSTGRES_MEMORY_LIMIT=1g
# DOCMOST_POSTGRES_CPU_LIMIT=1.0
# DOCMOST_POSTGRES_MEMORY_RESERVATION=128m
# DOCMOST_POSTGRES_CPU_RESERVATION=0.25
# DOCMOST_REDIS_MEMORY_LIMIT=256m
# DOCMOST_REDIS_CPU_LIMIT=0.5
# DOCMOST_REDIS_MEMORY_RESERVATION=32m
# DOCMOST_REDIS_CPU_RESERVATION=0.1
# DOCMOST_MEMORY_LIMIT=512m
# DOCMOST_CPU_LIMIT=1.0
# DOCMOST_MEMORY_RESERVATION=64m
# DOCMOST_CPU_RESERVATION=0.25
# TRAEFIK_MEMORY_LIMIT=256m
# TRAEFIK_CPU_LIMIT=0.5
# TRAEFIK_MEMORY_RESERVATION=64m
# TRAEFIK_CPU_RESERVATION=0.1
# DOCMOST_BACKUPS_MEMORY_LIMIT=256m
# DOCMOST_BACKUPS_CPU_LIMIT=0.5
# DOCMOST_BACKUPS_MEMORY_RESERVATION=32m
# DOCMOST_BACKUPS_CPU_RESERVATION=0.1

# Image versions. Every image is pinned by digest inside the compose file
# (x-images block); set the matching variable here to run a different version
# of that one image (Compose then pulls the tag, without a digest) while every
# other pin stays as tested. Setting <PREFIX>_IMAGE_TAG replaces the whole
# reference instead. Needs Docker Compose v2.5 or newer (2022).
# TRAEFIK_IMAGE_VERSION=3.7
# DOCMOST_POSTGRES_IMAGE_VERSION=16
# DOCMOST_REDIS_IMAGE_VERSION=7.4
# DOCMOST_IMAGE_VERSION=0.95.0
